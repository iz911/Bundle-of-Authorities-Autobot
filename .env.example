# ========================================================
# Bundle of Authorities (BOA) Autobot Configuration
# ========================================================

# Application Server Host & Port
PORT=2345
HOST=127.0.0.1

# ========================================================
# Local LLM Configuration (only the model status badge reads these)
# ========================================================
# Connect to any OpenAI-compatible local model runner:
# - Ollama:    http://localhost:11434/v1 (Port: 11434)
# - LM Studio: http://localhost:1234/v1  (Port: 1234)
# - LocalAI:   http://localhost:8080/v1  (Port: 8080)
# - vLLM:      http://localhost:8000/v1  (Port: 8000)

LOCAL_MODEL_ENABLED=true
LOCAL_MODEL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL_PORT=11434
LOCAL_MODEL_NAME=llama3.2
LOCAL_MODEL_TIMEOUT=30
